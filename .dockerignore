# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments / secrets (the .env file is passed with --env-file at run time)
.env
.venv
venv/
ENV/

# Source control
.git/
.gitignore

# Not needed in the Python image
android_edge/
node_modules/
scratch/
docs/
.agents/

# Runtime state lives in the mounted data volume, never baked into the image
data/*.json
data/vault/

# Do NOT ignore config/config.yaml (needed for engine configuration)
# Do NOT ignore src/ or package*.json (the web build stage needs them)
