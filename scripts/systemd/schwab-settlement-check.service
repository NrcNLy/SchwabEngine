[Unit]
Description=Schwab Automated Friday Settlement Watcher & Ledger Auditor
After=network.target schwab-trader.service
Wants=schwab-trader.service
OnFailure=schwab-notify@%n.service

[Service]
Type=oneshot
User=nicho
Group=nicho
WorkingDirectory=/home/nicho/schwab_engine
EnvironmentFile=/home/nicho/schwab_engine/.env
Environment=ENGINE_STATE_DIR=/home/nicho/schwab_state
ExecStart=/home/nicho/schwab_engine/.venv/bin/python scripts/verify_settlement_cron.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=schwab-settlement-check

[Install]
WantedBy=multi-user.target
